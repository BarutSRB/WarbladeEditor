# Copy to /etc/warblade-lobby/env on the droplet (mode 600, owner root) and
# set WB_ADMIN_TOKEN. The service reads this file at start.

# Public listeners (open TCP 7400 and UDP 7401 in the firewall).
WB_WS_BIND=0.0.0.0:7400
WB_UDP_BIND=0.0.0.0:7401

# Owner admin page: loopback only, reached through an ssh tunnel
# (make lobby-admin). At least 16 characters; leave unset to disable.
WB_ADMIN_BIND=127.0.0.1:7402
WB_ADMIN_TOKEN=change-this-to-a-long-random-string

# Storage and content rules (deploy.sh installs talents.json here).
WB_DB_PATH=/var/lib/warblade-lobby/lobby.db
WB_TALENTS_PATH=/etc/warblade-lobby/talents.json

# Optional: refuse clients whose compiled content hash differs.
# WB_EXPECTED_CONTENT_HASH=

# Capacity for the smallest droplet.
WB_MAX_CONNECTIONS=500
WB_MAX_CONNECTIONS_PER_IP=8
WB_MAX_LOBBIES=100

# tracing filter, e.g. info or info,warblade_lobby::rendezvous=debug
WB_LOG=info
